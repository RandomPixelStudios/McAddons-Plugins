{
  "id": "ruby",
  "name": "Ruby",
  "version": "1.1.0",
  "description": "A complete content mod as a Lua plugin: Ruby item, Ruby Block and Ruby Ore with textures, ore generation in the overworld, crafting recipes, zombies sometimes drop rubies, and right-clicking a ruby heals you. Needs one restart after installing.",
  "authors": ["RandomPixelStudios"],
  "api": "1.1",
  "side": "both",
  "permissions": ["content", "resources", "data", "players", "players.modify", "effects", "commands"],
  "content": {
    "items": [ { "id": "ruby", "name": "Ruby", "max_stack": 64, "glint": true } ],
    "blocks": [
      { "id": "ruby_block", "name": "Ruby Block", "hardness": 5, "resistance": 6, "light": 10, "sound": "metal" },
      { "id": "ruby_ore", "name": "Ruby Ore", "hardness": 3, "resistance": 3, "sound": "stone" }
    ],
    "ores": [ { "block": "ruby_ore", "dimension": "overworld", "size": 5, "per_chunk": 6, "min_y": -48, "max_y": 40 } ],
    "loot": [
      { "table": "minecraft:entities/zombie", "item": "ruby", "chance": 0.05 },
      { "table": "minecraft:chests/simple_dungeon", "item": "ruby", "chance": 0.6, "min": 1, "max": 4 }
    ]
  }
}
